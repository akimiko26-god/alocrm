{
  "name": "alocrm",
  "version": "1.0.0",
  "description": "Freelancer CRM System with Multi-platform Order Management",
  "main": "backend/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --exec node --experimental-modules backend/src/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "tsc",
    "start": "node backend/src/index.js",
    "migrate": "node backend/scripts/migrate.js",
    "seed": "node backend/scripts/seed.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.5.4",
    "pg": "^8.8.0",
    "mongoose": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "axios": "^1.3.4",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "joi": "^17.9.1",
    "morgan": "^1.10.0",
    "redis": "^4.6.5",
    "bull": "^4.10.4"
  },
  "devDependencies": {
    "@types/node": "^18.15.11",
    "@types/express": "^4.17.17",
    "typescript": "^5.0.2",
    "nodemon": "^2.0.20",
    "eslint": "^8.38.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "concurrently": "^8.0.1"
  }
}
